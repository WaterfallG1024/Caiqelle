<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Caiqelle.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Caiqelle">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Pure Black / Neutral Dark Surface Hierarchy (ブラーが透ける半透明設計) -->
            <SolidColorBrush x:Key="M3SurfaceBrush" Color="#9E0A0A0A" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowestBrush" Color="#88050505" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowBrush" Color="#90121212" />
            <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#9E1A1A1A" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighBrush" Color="#B8242424" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#CC303030" />

            <!-- Dynamic Accent Palette (Primary, Secondary, Tertiary) -->
            <SolidColorBrush x:Key="M3PrimaryBrush" Color="#00FF7F" />
            <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#004724" />
            <SolidColorBrush x:Key="M3PrimaryContainerGlassBrush" Color="#4400FF7F" />
            <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#111116" />
            <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#C7FFE3" />

            <SolidColorBrush x:Key="M3SecondaryBrush" Color="#47FFA3" />
            <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="#113D27" />
            <SolidColorBrush x:Key="M3SecondaryContainerGlassBrush" Color="#4047FFA3" />
            <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="#D1FFE8" />

            <SolidColorBrush x:Key="M3TertiaryBrush" Color="#A3A3A3" />
            <SolidColorBrush x:Key="M3TertiaryContainerBrush" Color="#262626" />
            <SolidColorBrush x:Key="M3TertiaryContainerGlassBrush" Color="#40A3A3A3" />
            <SolidColorBrush x:Key="M3OnTertiaryContainerBrush" Color="#E5E5E5" />

            <!-- Base Colors (Crisp White Text & Pure Black Hierarchy) -->
            <SolidColorBrush x:Key="AfterGlowBackgroundBrush" Color="#0A0A0A" />
            <SolidColorBrush x:Key="AfterGlowSurfaceGlassBrush" Color="#D81A1A1A" />
            <SolidColorBrush x:Key="AfterGlowSurfaceHoverBrush" Color="#F0242424" />
            <SolidColorBrush x:Key="AfterGlowTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AfterGlowTextSecondaryBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AfterGlowTextTertiaryBrush" Color="#848484" />

            <!-- Accent Gradient -->
            <LinearGradientBrush x:Key="AfterGlowAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#00FF7F" Offset="0.0" />
                <GradientStop Color="#47FFA3" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 半透明ダーク＋テーマカラーグラデーション背景 -->
            <LinearGradientBrush x:Key="ThemeWindowBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C60B2217" Offset="0.0" />
                <GradientStop Color="#BC0B0D0C" Offset="0.55" />
                <GradientStop Color="#C80D1C14" Offset="1.0" />
            </LinearGradientBrush>
            
            <SolidColorBrush x:Key="AfterGlowAccentBrush" Color="#00FF7F" />

            <!-- Material You 3 Expressive Functional Colors (Vibrant & Legible) -->
            <SolidColorBrush x:Key="FuncBlueBrush" Color="#5EA2FF" />
            <SolidColorBrush x:Key="FuncBlueBgBrush" Color="#3D5EA2FF" />
            
            <SolidColorBrush x:Key="FuncCyanBrush" Color="#00E5E6" />
            <SolidColorBrush x:Key="FuncCyanBgBrush" Color="#3D00E5E6" />
            
            <SolidColorBrush x:Key="FuncPurpleBrush" Color="#C79CFF" />
            <SolidColorBrush x:Key="FuncPurpleBgBrush" Color="#3DC79CFF" />
            
            <SolidColorBrush x:Key="FuncGreenBrush" Color="#00F285" />
            <SolidColorBrush x:Key="FuncGreenBgBrush" Color="#3D00F285" />
            
            <SolidColorBrush x:Key="FuncPinkBrush" Color="#FF5C82" />
            <SolidColorBrush x:Key="FuncPinkBgBrush" Color="#3DFF5C82" />
            
            <SolidColorBrush x:Key="FuncOrangeBrush" Color="#FFA224" />
            <SolidColorBrush x:Key="FuncOrangeBgBrush" Color="#3DFFA224" />

            <!-- Common Button Styles (No White Borders / Expressive Rounding) -->
            <Style x:Key="AfterGlowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AfterGlowTextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>

            <!-- M3 Expressive Card Button Style (No Border, Tonal Surface Container, CornerRadius 16) -->
            <Style x:Key="CardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource M3SurfaceContainerBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,16" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <!-- M3 Tonal Button Style -->
            <Style x:Key="M3PillTonalButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighestBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AfterGlowTextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>

            <!-- M3 Filled Primary Button Style -->
            <Style x:Key="M3FilledPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource M3PrimaryBrush}" />
                <Setter Property="Foreground" Value="{StaticResource M3OnPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
