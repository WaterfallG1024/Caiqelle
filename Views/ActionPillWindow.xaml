<winuiex:WindowEx
    x:Class="Caiqelle.Views.ActionPillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    mc:Ignorable="d"
    Title="Caiqelle Action">

    <Grid x:Name="RootGrid" Background="Transparent" Width="192" Height="62">
        <Grid.Resources>
            <Storyboard x:Name="ShowCapsuleStoryboard">
                <DoubleAnimation Storyboard.TargetName="CapsuleScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1.0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="CapsuleScale" Storyboard.TargetProperty="ScaleY" From="0.90" To="1.0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="CapsuleBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                <DoubleAnimation Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.04" Duration="0:0:0.16" />
            </Storyboard>
            <Storyboard x:Name="HideCapsuleStoryboard">
                <DoubleAnimation Storyboard.TargetName="CapsuleScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="CapsuleScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ContentGrid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                <DoubleAnimation Storyboard.TargetName="CapsuleBorder" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.05" Duration="0:0:0.11" />
            </Storyboard>
        </Grid.Resources>

        <!-- DynamicCapsule 非展開時と同一サイズ (192x62, CornerRadius=31) -->
        <Border x:Name="CapsuleBorder"
                Width="192"
                Height="62"
                CornerRadius="31"
                Background="#E6000000"
                BorderBrush="#66FFFFFF"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0"
                PointerEntered="CapsuleBorder_PointerEntered"
                PointerExited="CapsuleBorder_PointerExited">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CapsuleScale" ScaleX="1.0" ScaleY="1.0" />
            </Border.RenderTransform>
            <Grid>
                <Grid x:Name="ContentGrid" Padding="13,0,9,0" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 表示テキスト（「Action検知：○件」のみ） -->
                    <TextBlock x:Name="SummaryText"
                               Grid.Column="0"
                               Text="Action検知：1件"
                               Foreground="White"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,4,0" />

                    <!-- 入力ボタン -->
                    <Button x:Name="ApplyButton"
                            Grid.Column="1"
                            Style="{StaticResource M3FilledPrimaryButtonStyle}"
                            Content="入力"
                            CornerRadius="13"
                            Height="26"
                            Padding="9,0"
                            FontSize="11"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Click="ApplyButton_Click" />

                    <!-- 閉じるボタン -->
                    <Button x:Name="DismissButton"
                            Grid.Column="2"
                            Width="22"
                            Height="22"
                            CornerRadius="11"
                            Padding="0"
                            Background="#24FFFFFF"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            Click="DismissButton_Click"
                            ToolTipService.ToolTip="閉じる">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="9.5" Foreground="#E6FFFFFF" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</winuiex:WindowEx>
