<Window
    x:Class="Caiqelle.Views.LivePinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Live Pin">

    <Grid x:Name="RootGrid"
          Background="#FF0A0A0C"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerWheelChanged="RootGrid_PointerWheelChanged"
          KeyDown="RootGrid_KeyDown"
          IsTabStop="True">

        <!-- Live Stream Image (枠内にクリップしてコンテンツのみ拡大・縮小) -->
        <Grid x:Name="ViewportGrid" SizeChanged="ViewportGrid_SizeChanged">
            <Image x:Name="LiveImage"
                   Stretch="Uniform"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="ImageTransform" />
                </Image.RenderTransform>
            </Image>
        </Grid>

        <!-- LIVE / PAUSE ステータスバッジ (左上に控えめに表示) -->
        <Border x:Name="StatusBadge"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="10,10,0,0"
                Background="{StaticResource FluentSurfaceContainerHighestBrush}"
                CornerRadius="8"
                Padding="8,4"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource FluentPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="LIVE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
