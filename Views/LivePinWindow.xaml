<Window
    x:Class="Caiqelle.Views.LivePinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Live Pin">

    <Grid x:Name="RootGrid"
          Background="#FF0A0A0C"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed"
          PointerWheelChanged="RootGrid_PointerWheelChanged"
          KeyDown="RootGrid_KeyDown"
          IsTabStop="True">

        <!-- Live Stream Image -->
        <Image x:Name="LiveImage" Stretch="Uniform" />

        <!-- LIVE / PAUSE ステータスバッジ (左上に控えめに表示) -->
        <Border x:Name="StatusBadge"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="10,10,0,0"
                Background="{StaticResource M3SurfaceContainerHighestBrush}"
                CornerRadius="8"
                Padding="8,4"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource M3PrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Overlay UI (ホバー時表示) -->
        <Border x:Name="OverlayPanel"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,12,0,0"
                Background="{StaticResource M3SurfaceContainerHighestBrush}"
                BorderThickness="0"
                CornerRadius="12"
                Padding="6,4"
                Opacity="0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="PauseResumeBtn" ToolTipService.ToolTip="一時停止 / 再開 (Space)" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="PauseResumeBtn_Click">
                    <FontIcon x:Name="PauseResumeIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE769;" FontSize="15" Foreground="{StaticResource M3PrimaryBrush}" />
                </Button>

                <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="2,0" VerticalAlignment="Center" />

                <Button x:Name="ZoomOutBtn" ToolTipService.ToolTip="縮小 (-)" Width="28" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ZoomOutBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE738;" FontSize="13" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                </Button>

                <Button x:Name="ScaleResetBtn" ToolTipService.ToolTip="倍率切替 (1x / 2x / 3x)" Height="32" MinWidth="40" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="6,0" Click="ScaleResetBtn_Click">
                    <TextBlock x:Name="ScaleText" Text="2x" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>

                <Button x:Name="ZoomInBtn" ToolTipService.ToolTip="拡大 (+)" Width="28" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ZoomInBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="13" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                </Button>

                <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="2,0" VerticalAlignment="Center" />

                <Button x:Name="CopyBtn" ToolTipService.ToolTip="コピー (Ctrl + C)" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="CopyBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="15" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                </Button>

                <Button x:Name="SaveBtn" ToolTipService.ToolTip="保存 (Ctrl + S)" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="SaveBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE792;" FontSize="15" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                </Button>

                <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="2,0" VerticalAlignment="Center" />

                <Button x:Name="CloseBtn" ToolTipService.ToolTip="ライブピン留め解除 (Esc)" Width="32" Height="32" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="CloseBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="15" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
