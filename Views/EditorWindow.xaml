<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Caiqelle.Views.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Caiqelle"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Caiqelle Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="False" KeyDown="EditorWindow_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom TitleBar & App Title -->
        <Grid x:Name="AppTitleBar" Height="60" Background="Transparent" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Title -->
            <TextBlock Text="Caiqelle" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14" FontFamily="Segoe UI Variable Display" FontWeight="Bold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
            
            <!-- Floating Toolbar (M3 Expressive Tonal Bar) -->
            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>
                <!-- UIElement translation is needed for ThemeShadow to show up in Z space -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="6,4" Translation="0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Drawing Tools (Top Bar) -->
                        <ToggleButton x:Name="PenBtn" ToolTipService.ToolTip="ペン" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Pen" IsChecked="{x:Bind ViewModel.IsPenSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED63;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ShapesBtn" ToolTipService.ToolTip="図形" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Shapes" IsChecked="{x:Bind ViewModel.IsShapeSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF158;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        <ToggleButton x:Name="NumberBtn" ToolTipService.ToolTip="ステップ番号" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Number" IsChecked="{x:Bind ViewModel.IsNumberSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF146;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>

                        <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- Color Picker Button (Clean Squircle No Clip) -->
                        <Button x:Name="ColorBtn" ToolTipService.ToolTip="色選択" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0">
                            <Border x:Name="ColorPreviewBorder" Width="18" Height="18" CornerRadius="5" Background="{x:Bind ViewModel.SelectedColorBrush, Mode=OneWay}" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="EditorColorPicker" 
                                                 Color="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}"
                                                 ColorSpectrumShape="Ring" 
                                                 IsMoreButtonVisible="False" 
                                                 IsColorSliderVisible="True" 
                                                 IsColorChannelTextInputVisible="False" 
                                                 IsHexInputVisible="True" 
                                                 IsAlphaEnabled="True" 
                                                 IsAlphaSliderVisible="True" 
                                                 IsAlphaTextInputVisible="False" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- Undo / Redo -->
                        <Button x:Name="UndoBtn" ToolTipService.ToolTip="元に戻す (Ctrl+Z)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.UndoCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                        <Button x:Name="RedoBtn" ToolTipService.ToolTip="やり直す (Ctrl+Y)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.RedoCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                        
                        <ToggleButton x:Name="DeleteBtn" ToolTipService.ToolTip="削除" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Erase" IsChecked="{x:Bind ViewModel.IsEraseSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE75C;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>

                        <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />
                        
                        <Button x:Name="CopyButton" ToolTipService.ToolTip="コピー(またはCtrl + C)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.CopyCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                        <Button x:Name="SaveButton" ToolTipService.ToolTip="保存(またはCtrl + S)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SaveCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE792;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Image Editor Canvas -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="5.0">
            <Grid Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>
                
                <Image x:Name="CapturedImage" Stretch="Fill" />
                <Canvas x:Name="DrawCanvas"
                        Background="#01000000"
                        ManipulationMode="None"
                        PointerPressed="DrawCanvas_PointerPressed" 
                        PointerMoved="DrawCanvas_PointerMoved" 
                        PointerReleased="DrawCanvas_PointerReleased" />
            </Grid>
        </ScrollViewer>

        <!-- Pen Sub-Toolbar (2nd Row) -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,8,0,0"
              Visibility="{x:Bind ViewModel.IsPenSelected, Mode=OneWay}">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Border Background="{StaticResource M3SurfaceContainerHighestBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="12,4"
                    Translation="0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED63;" FontSize="14" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" />
                    <TextBlock Text="太さ" FontSize="12" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider Width="120"
                            Minimum="1"
                            Maximum="24"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.PenThickness, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.PenThicknessText, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AfterGlowTextPrimaryBrush}"
                               MinWidth="30"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Shapes Sub-Toolbar (2nd Row, Snipping Tool Style) -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,8,0,0"
              Visibility="{x:Bind ViewModel.IsShapeSelected, Mode=OneWay}">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Border Background="{StaticResource M3SurfaceContainerHighestBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="8,4"
                    Translation="0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="RectBtn" ToolTipService.ToolTip="四角形" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Rect" IsChecked="{x:Bind ViewModel.IsRectSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE739;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    <ToggleButton x:Name="EllipseBtn" ToolTipService.ToolTip="楕円" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Ellipse" IsChecked="{x:Bind ViewModel.IsEllipseSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA3A;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    <ToggleButton x:Name="LineBtn" ToolTipService.ToolTip="直線" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Line" IsChecked="{x:Bind ViewModel.IsLineSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF464;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    <ToggleButton x:Name="DashedLineBtn" ToolTipService.ToolTip="点線" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="DashedLine" IsChecked="{x:Bind ViewModel.IsDashedLineSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                        <Line X1="2" Y1="14" X2="14" Y2="2" Width="16" Height="16" Stroke="{StaticResource AfterGlowTextPrimaryBrush}" StrokeThickness="2" StrokeDashArray="2,1.5" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                    </ToggleButton>
                    <ToggleButton x:Name="ArrowBtn" ToolTipService.ToolTip="矢印" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Command="{x:Bind ViewModel.SelectToolCommand}" CommandParameter="Arrow" IsChecked="{x:Bind ViewModel.IsArrowSelected, Mode=OneWay}" Click="ToolToggleButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE742;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>

                    <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <ToggleButton x:Name="FillBtn" ToolTipService.ToolTip="図形の塗りつぶし（四角形・楕円のみ）" Height="34" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0" CornerRadius="8" Padding="10,0" IsChecked="{x:Bind ViewModel.IsFillEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsFillCapable, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB33;" FontSize="15" />
                            <TextBlock Text="塗りつぶし" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Delete Sub-Toolbar (2nd Row) -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,8,0,0"
              Visibility="{x:Bind ViewModel.IsEraseSelected, Mode=OneWay}">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Border Background="{StaticResource M3SurfaceContainerHighestBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="8,4"
                    Translation="0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="EraseModeBtn" ToolTipService.ToolTip="描画物をクリックして削除" Height="34" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0" CornerRadius="8" Padding="10,0" IsChecked="True" Click="ToolToggleButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE75C;" FontSize="15" />
                            <TextBlock Text="クリックして削除" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <Button x:Name="ClearAllBtn" ToolTipService.ToolTip="編集をすべて消去" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,0" Command="{x:Bind ViewModel.ClearCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="15" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                            <TextBlock Text="すべて消去" FontSize="12" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Folder Selection Overlay Removed -->
    </Grid>
</Window>
