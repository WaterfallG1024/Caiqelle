<Window
    x:Class="Caiqelle.Views.StickyTextListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Caiqelle.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sticky View">

    <Grid x:Name="RootGrid"
          Background="{StaticResource ThemeWindowBackgroundGradientBrush}"
          CornerRadius="0"
          BorderThickness="0"
          KeyDown="RootGrid_KeyDown"
          IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Sticky View"
                           Foreground="{StaticResource AfterGlowTextPrimaryBrush}"
                           FontFamily="Segoe UI Variable Display"
                           FontWeight="Bold"
                           FontSize="18" />
                <TextBlock x:Name="SubtitleText"
                           Text="保存済み: 0 件"
                           Foreground="{StaticResource AfterGlowTextSecondaryBrush}"
                           FontSize="11" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="NewBtn"
                        Style="{StaticResource M3FilledPrimaryButtonStyle}"
                        Padding="12,6"
                        CornerRadius="10"
                        Click="NewBtn_Click"
                        ToolTipService.ToolTip="新しい Sticky Text を作成">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="新規" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="CloseBtn"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0"
                        Click="CloseBtn_Click"
                        ToolTipService.ToolTip="閉じる (Esc)">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="13" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- List Area -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:StickyTextListItemView">
                            <Border Background="{StaticResource M3SurfaceContainerBrush}"
                                    CornerRadius="12"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Background="{x:Bind StatusBackground}"
                                                    CornerRadius="6"
                                                    Padding="7,2">
                                                <TextBlock Text="{x:Bind StatusLabel}"
                                                           Foreground="{x:Bind StatusForeground}"
                                                           FontSize="10"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <Border Background="{StaticResource M3SurfaceContainerHighestBrush}"
                                                    CornerRadius="6"
                                                    Padding="7,2"
                                                    Visibility="{x:Bind StealthBadgeVisibility}">
                                                <TextBlock Text="カンペ"
                                                           Foreground="{StaticResource M3PrimaryBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind PreviewText}"
                                                   Foreground="{StaticResource AfterGlowTextPrimaryBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind Id}"
                                                Click="ToggleShowBtn_Click"
                                                Background="{StaticResource M3SurfaceContainerHighestBrush}"
                                                Foreground="{StaticResource AfterGlowTextPrimaryBrush}"
                                                BorderThickness="0"
                                                CornerRadius="8"
                                                Padding="10,6"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Content="{x:Bind ToggleButtonLabel}"
                                                ToolTipService.ToolTip="{x:Bind ToggleButtonToolTip}" />

                                        <Button Tag="{x:Bind Id}"
                                                Click="DeleteItemBtn_Click"
                                                Width="32"
                                                Height="32"
                                                Background="{StaticResource FuncPinkBgBrush}"
                                                BorderThickness="0"
                                                CornerRadius="8"
                                                Padding="0"
                                                Visibility="{x:Bind DeleteButtonVisibility}"
                                                ToolTipService.ToolTip="完全に削除">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="13" Foreground="{StaticResource FuncPinkBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70B;" FontSize="28" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" />
                <TextBlock x:Name="EmptyStateText"
                           Text="保存されている Sticky Text はありません"
                           Foreground="{StaticResource AfterGlowTextSecondaryBrush}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource M3SurfaceContainerLowBrush}"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="FooterHintText"
                           Text="Esc で閉じる"
                           Foreground="{StaticResource AfterGlowTextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        x:Name="DeleteAllBtn"
                        Background="{StaticResource FuncPinkBgBrush}"
                        Foreground="{StaticResource FuncPinkBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="12,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="すべて削除">
                    <Button.Flyout>
                        <Flyout x:Name="DeleteAllConfirmFlyout">
                            <StackPanel Spacing="10" MaxWidth="220">
                                <TextBlock Text="保存されている Sticky Text をすべて削除しますか？"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                                <Button Content="すべて削除する"
                                        Background="{StaticResource FuncPinkBgBrush}"
                                        Foreground="{StaticResource FuncPinkBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        HorizontalAlignment="Right"
                                        Click="ConfirmDeleteAllBtn_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
