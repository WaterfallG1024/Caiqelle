<Window
    x:Class="Caiqelle.Views.FloatingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FloatingWindow">

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown">
        <!-- Spring Animation setup in Code Behind -->
        <Border x:Name="ContentBorder" Background="Transparent" BorderThickness="0" Opacity="0" CornerRadius="0">
            <StackPanel x:Name="CaptureButtonsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,10" Spacing="10" Visibility="Visible" Width="560">
                <!-- Group 1: キャプチャ (4 Cards) -->
                <Border Background="{StaticResource M3SurfaceContainerLowBrush}"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10,8,10,10">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource M3PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="キャプチャ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="6,10" Command="{x:Bind ViewModel.CaptureRegionCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                    <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73F;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="範囲指定 (C)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="6,10" Command="{x:Bind ViewModel.CaptureWindowCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                    <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF7ED;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="ウィンドウ (W)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="6,10" Command="{x:Bind ViewModel.CaptureFullscreenCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                    <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="全画面 (F)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="6,10" Command="{x:Bind ViewModel.CaptureOcrCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                    <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D2;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="テキスト抽出 (E)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Row 2: Group 2 (ピン・リワインド) & Group 3 (Sticky Text) -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Group 2: ピン・リワインド (3 Cards) -->
                    <Border Grid.Column="0"
                            Background="{StaticResource M3SurfaceContainerLowBrush}"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="10,8,10,10">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="ピン・リワインド" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="4,10" Command="{x:Bind ViewModel.CapturePinCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                        <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE718;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="ピン留め (P)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="4,10" Command="{x:Bind ViewModel.CaptureLivePinCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                        <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A3;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="ライブピン (L)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="4,10" Command="{x:Bind ViewModel.OpenRewindCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                        <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="リワインド (R)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Group 3: Sticky Text (2 Cards) -->
                    <Border Grid.Column="1"
                            Background="{StaticResource M3SurfaceContainerLowBrush}"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="10,8,10,10">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource M3PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Sticky Text" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="4,10" Command="{x:Bind ViewModel.OpenStickyTextCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                        <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70B;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="Sticky Text (S)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Style="{StaticResource CardButtonStyle}" Background="{StaticResource ThemeWindowBackgroundGradientBrush}" Height="94" Padding="4,10" Command="{x:Bind ViewModel.OpenStickyTextListCommand}" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited" PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                        <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource M3PrimaryContainerGlassBrush}" HorizontalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;" FontSize="17" Foreground="{StaticResource M3PrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="Sticky View (V)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
