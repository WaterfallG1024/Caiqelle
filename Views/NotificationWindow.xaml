<Window
    x:Class="Caiqelle.Views.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Notification">

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Shadow>
            <ThemeShadow />
        </Grid.Shadow>
        <!-- Floating Fluent Toast Container (視認性を高めるため不透明ベース背景＋影) -->
        <Border x:Name="ContentBorder"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Translation="0,0,16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0" Padding="18,12">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconContainer" Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{StaticResource FuncGreenBgBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <FontIcon x:Name="IconElement" FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="16" Foreground="{StaticResource FuncGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 対象名（長い場合は...で短縮） -->
                <TextBlock x:Name="MessageText" Grid.Column="1" Text="Notification" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <!-- アクション（「に保存しました」等、必ず右側に固定表示） -->
                <TextBlock x:Name="SuffixText" Grid.Column="2" Text="" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
