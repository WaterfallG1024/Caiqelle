<Window
    x:Class="Caiqelle.Views.WindowSelectionOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ウィンドウを選択">

    <Grid Background="Black">
        <Image x:Name="BackgroundImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
        
        <Canvas x:Name="DrawCanvas" Background="Transparent" 
                PointerMoved="Window_PointerMoved" 
                PointerReleased="Window_PointerReleased" 
                KeyDown="Window_KeyDown" IsTabStop="True">
                
            <!-- ウィンドウホバー枠 (Fluent 2 Accent Highlight) -->
            <Rectangle x:Name="HighlightBox" 
                       Stroke="{StaticResource FluentPrimaryBrush}" 
                       StrokeThickness="2" 
                       RadiusX="10"
                       RadiusY="10"
                       Fill="{StaticResource FluentPrimaryContainerGlassBrush}" 
                       Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
