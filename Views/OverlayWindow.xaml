<Window
    x:Class="Caiqelle.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Capture Selection Overlay">

    <Grid x:Name="RootGrid" KeyDown="Window_KeyDown" Background="Transparent">
        <!-- Captured Background -->
        <Image x:Name="BackgroundImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
        
        <!-- Darken Overlay with Cutout -->
        <Path x:Name="OverlayDimmer" Fill="#A0000000" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <!-- Outer bounds will be set in code to screen size -->
                    <RectangleGeometry x:Name="OuterDimmerRect" />
                    <!-- Inner bounds is the selected region cutout -->
                    <RectangleGeometry x:Name="CutoutRect" />
                </GeometryGroup>
            </Path.Data>
        </Path>
        
        <!-- Main Interaction Canvas -->
        <Canvas x:Name="DrawCanvas" Background="Transparent" 
                PointerPressed="Window_PointerPressed" 
                PointerMoved="Window_PointerMoved" 
                PointerReleased="Window_PointerReleased" 
                IsTabStop="True">
                
            <!-- Annotations Canvas (Only visible in edit mode) -->
            <Canvas x:Name="AnnotationCanvas" Background="Transparent" Visibility="Collapsed" />
                
            <!-- Selection Box Border -->
            <Rectangle x:Name="SelectionBox" 
                       Stroke="White" 
                       StrokeThickness="1" 
                       Fill="Transparent" 
                       Visibility="Collapsed" 
                       IsHitTestVisible="False"/>
                       
            <!-- Resize Handles (Corners and Edges) -->
            <!-- Top Left -->
            <Grid x:Name="HandleTL" Width="20" Height="20" Background="Transparent" Visibility="Collapsed">
                <Path Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,16 L 0,0 L 16,0" />
            </Grid>
            <!-- Top Right -->
            <Grid x:Name="HandleTR" Width="20" Height="20" Background="Transparent" Visibility="Collapsed">
                <Path Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 4,0 L 20,0 L 20,16" />
            </Grid>
            <!-- Bottom Left -->
            <Grid x:Name="HandleBL" Width="20" Height="20" Background="Transparent" Visibility="Collapsed">
                <Path Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,4 L 0,20 L 16,20" />
            </Grid>
            <!-- Bottom Right -->
            <Grid x:Name="HandleBR" Width="20" Height="20" Background="Transparent" Visibility="Collapsed">
                <Path Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 20,4 L 20,20 L 4,20" />
            </Grid>
            
            <Rectangle x:Name="HandleT" Width="24" Height="6" RadiusX="3" RadiusY="3" Fill="White" Visibility="Collapsed" />
            <Rectangle x:Name="HandleB" Width="24" Height="6" RadiusX="3" RadiusY="3" Fill="White" Visibility="Collapsed" />
            <Rectangle x:Name="HandleL" Width="6" Height="24" RadiusX="3" RadiusY="3" Fill="White" Visibility="Collapsed" />
            <Rectangle x:Name="HandleR" Width="6" Height="24" RadiusX="3" RadiusY="3" Fill="White" Visibility="Collapsed" />
            
            <!-- OCR Scanning Animation Line -->
            <Rectangle x:Name="OcrScanLine" Height="2" Fill="{StaticResource AfterGlowAccentBrush}" Opacity="0.8" Visibility="Collapsed" IsHitTestVisible="False" />
        </Canvas>

        <!-- Floating Toolbar (M3 Expressive Tonal Bar) -->
        <Grid x:Name="FloatingToolbar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Border Background="{StaticResource M3SurfaceContainerHighestBrush}" 
                    BorderThickness="0" CornerRadius="14" Padding="6,4" Translation="0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- Drawing Tools (M3 Squircle 34x34 buttons) -->
                    <ToggleButton x:Name="PenBtn" ToolTipService.ToolTip="ペン" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click" IsChecked="True">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC87;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    <ToggleButton x:Name="LineBtn" ToolTipService.ToolTip="直線" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF464;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    <ToggleButton x:Name="ArrowBtn" ToolTipService.ToolTip="矢印" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE742;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    <ToggleButton x:Name="RectBtn" ToolTipService.ToolTip="四角形" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE739;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    <ToggleButton x:Name="NumberBtn" ToolTipService.ToolTip="番号" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF146;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    
                    <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />
                    
                    <!-- Color & Fill -->
                    <ToggleButton x:Name="FillBtn" ToolTipService.ToolTip="塗りつぶし" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="FillBtn_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB33;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </ToggleButton>
                    <!-- Color Picker Button (Clean Squircle No Clip) -->
                    <Button x:Name="ColorBtn" ToolTipService.ToolTip="色選択" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0">
                        <Border x:Name="ColorPreviewBorder" Width="18" Height="18" CornerRadius="5" Background="Red" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="EditorColorPicker" 
                                             ColorChanged="EditorColorPicker_ColorChanged"
                                             ColorSpectrumShape="Ring" 
                                             IsMoreButtonVisible="False" 
                                             IsColorSliderVisible="True" 
                                             IsColorChannelTextInputVisible="False" 
                                             IsHexInputVisible="True" 
                                             IsAlphaEnabled="True" 
                                             IsAlphaSliderVisible="True" 
                                             IsAlphaTextInputVisible="False" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    
                    <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />
                    
                    <!-- Actions -->
                    <Button x:Name="UndoBtn" ToolTipService.ToolTip="元に戻す (Ctrl+Z)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="UndoBtn_Click" IsEnabled="False">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </Button>
                    <Button x:Name="RedoBtn" ToolTipService.ToolTip="やり直す (Ctrl+Y)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="RedoBtn_Click" IsEnabled="False">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </Button>
                    <Button x:Name="ClearButton" ToolTipService.ToolTip="編集をすべて消去" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ClearButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </Button>
                    
                    <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />
                    
                    <Button x:Name="CopyButton" ToolTipService.ToolTip="コピー(またはCtrl + C)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="CopyButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </Button>
                    <Button x:Name="SaveButton" ToolTipService.ToolTip="保存(またはCtrl + S)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="SaveButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE792;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </Button>
                    <Button x:Name="CancelButton" ToolTipService.ToolTip="閉じる (Esc)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="CancelButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
