<Window
    x:Class="Caiqelle.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Caiqelle.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Capture Selection Overlay">

    <Grid x:Name="RootGrid" KeyDown="Window_KeyDown" Background="Transparent">
        <!-- Captured Background -->
        <Image x:Name="BackgroundImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
        
        <!-- Darken Overlay with Cutout -->
        <Path x:Name="OverlayDimmer" Fill="#A0000000" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <!-- Outer bounds will be set in code to screen size -->
                    <RectangleGeometry x:Name="OuterDimmerRect" />
                    <!-- Inner bounds is the selected region cutout -->
                    <RectangleGeometry x:Name="CutoutRect" />
                </GeometryGroup>
            </Path.Data>
        </Path>
        
        <!-- Main Interaction Canvas -->
        <views:CursorCanvas x:Name="DrawCanvas" Background="Transparent" 
                PointerPressed="Window_PointerPressed" 
                PointerMoved="Window_PointerMoved" 
                PointerReleased="Window_PointerReleased" 
                IsTabStop="True">
                
            <!-- Annotations Canvas (Only visible in edit mode) -->
            <Canvas x:Name="AnnotationCanvas" Background="Transparent" Visibility="Collapsed" />
                
            <!-- Selection Box Border -->
            <Rectangle x:Name="SelectionBox" 
                       Stroke="{StaticResource FluentPrimaryBrush}" 
                       StrokeThickness="1" 
                       Fill="Transparent" 
                       Visibility="Collapsed" 
                       IsHitTestVisible="False"/>
                       
            <!-- Resize Handles (Corners and Edges with enlarged hitboxes) -->
            <!-- Top Left -->
            <Grid x:Name="HandleTL" Width="28" Height="28" Background="Transparent" Visibility="Collapsed">
                <Path Margin="4" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,16 L 0,0 L 16,0" />
            </Grid>
            <!-- Top Right -->
            <Grid x:Name="HandleTR" Width="28" Height="28" Background="Transparent" Visibility="Collapsed">
                <Path Margin="4" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 4,0 L 20,0 L 20,16" />
            </Grid>
            <!-- Bottom Left -->
            <Grid x:Name="HandleBL" Width="28" Height="28" Background="Transparent" Visibility="Collapsed">
                <Path Margin="4" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,4 L 0,20 L 16,20" />
            </Grid>
            <!-- Bottom Right -->
            <Grid x:Name="HandleBR" Width="28" Height="28" Background="Transparent" Visibility="Collapsed">
                <Path Margin="4" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 20,4 L 20,20 L 4,20" />
            </Grid>
            
            <Grid x:Name="HandleT" Width="40" Height="22" Background="Transparent" Visibility="Collapsed">
                <Rectangle Width="24" Height="6" RadiusX="3" RadiusY="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="HandleB" Width="40" Height="22" Background="Transparent" Visibility="Collapsed">
                <Rectangle Width="24" Height="6" RadiusX="3" RadiusY="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="HandleL" Width="22" Height="40" Background="Transparent" Visibility="Collapsed">
                <Rectangle Width="6" Height="24" RadiusX="3" RadiusY="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="HandleR" Width="22" Height="40" Background="Transparent" Visibility="Collapsed">
                <Rectangle Width="6" Height="24" RadiusX="3" RadiusY="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            
            <!-- OCR Scanning Animation Line -->
            <Rectangle x:Name="OcrScanLine" Height="2" Fill="{StaticResource AfterGlowAccentBrush}" Opacity="0.8" Visibility="Collapsed" IsHitTestVisible="False" />
        </views:CursorCanvas>

        <!-- Floating Toolbar (Snipping Tool Multi-Row Style) -->
        <views:CursorGrid x:Name="FloatingToolbar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <!-- Row 1: Primary Tools & Actions -->
                <Border Background="{StaticResource FluentSurfaceContainerHighestBrush}" 
                        BorderThickness="0" CornerRadius="14" Padding="6,4" Translation="0,0,16"
                        HorizontalAlignment="Center">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Drawing Tools (Top Bar) -->
                        <ToggleButton x:Name="PenBtn" ToolTipService.ToolTip="ペン" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED63;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ShapesBtn" ToolTipService.ToolTip="図形" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click" IsChecked="True">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF158;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        <ToggleButton x:Name="NumberBtn" ToolTipService.ToolTip="番号" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF146;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        
                        <Rectangle Width="1" Height="18" Fill="{StaticResource FluentSurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />
                        
                        <!-- Color Picker Button (Clean Squircle No Clip) -->
                        <Button x:Name="ColorBtn" ToolTipService.ToolTip="色選択" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0">
                            <Border x:Name="ColorPreviewBorder" Width="18" Height="18" CornerRadius="5" Background="Red" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="EditorColorPicker" 
                                                 Color="Red"
                                                 ColorChanged="EditorColorPicker_ColorChanged"
                                                 ColorSpectrumShape="Ring" 
                                                 IsMoreButtonVisible="False" 
                                                 IsColorSliderVisible="True" 
                                                 IsColorChannelTextInputVisible="False" 
                                                 IsHexInputVisible="True" 
                                                 IsAlphaEnabled="True" 
                                                 IsAlphaSliderVisible="True" 
                                                 IsAlphaTextInputVisible="False" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        
                        <Rectangle Width="1" Height="18" Fill="{StaticResource FluentSurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />
                        
                        <!-- Actions -->
                        <Button x:Name="UndoBtn" ToolTipService.ToolTip="元に戻す (Ctrl+Z)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="UndoBtn_Click" IsEnabled="False">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                        <Button x:Name="RedoBtn" ToolTipService.ToolTip="やり直す (Ctrl+Y)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="RedoBtn_Click" IsEnabled="False">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                        <ToggleButton x:Name="DeleteBtn" ToolTipService.ToolTip="削除" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE75C;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        
                        <Rectangle Width="1" Height="18" Fill="{StaticResource FluentSurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />
                        
                        <Button x:Name="CopyButton" ToolTipService.ToolTip="コピー(またはCtrl + C)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="CopyButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                        <Button x:Name="SaveButton" ToolTipService.ToolTip="保存(またはCtrl + S)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="SaveButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE792;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                        <Button x:Name="CancelButton" ToolTipService.ToolTip="閉じる (Esc)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="CancelButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Row 2: Pen Sub-Toolbar -->
                <Border x:Name="PenSubBar"
                        Background="{StaticResource FluentSurfaceContainerHighestBrush}"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="12,4"
                        Translation="0,0,16"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED63;" FontSize="14" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" />
                        <TextBlock Text="太さ" FontSize="12" Foreground="{StaticResource AfterGlowTextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider x:Name="PenThicknessSlider"
                                Width="120"
                                Minimum="1"
                                Maximum="24"
                                StepFrequency="1"
                                Value="4"
                                ValueChanged="PenThicknessSlider_ValueChanged"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="PenThicknessText"
                                   Text="4px"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AfterGlowTextPrimaryBrush}"
                                   MinWidth="30"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Row 2: Shapes Sub-Toolbar -->
                <Border x:Name="ShapesSubBar"
                        Background="{StaticResource FluentSurfaceContainerHighestBrush}"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="8,4"
                        Translation="0,0,16"
                        HorizontalAlignment="Center"
                        Visibility="Visible">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton x:Name="RectBtn" ToolTipService.ToolTip="四角形" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click" IsChecked="True">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE739;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        <ToggleButton x:Name="EllipseBtn" ToolTipService.ToolTip="楕円" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA3A;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        <ToggleButton x:Name="LineBtn" ToolTipService.ToolTip="直線" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF464;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>
                        <ToggleButton x:Name="DashedLineBtn" ToolTipService.ToolTip="点線" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                            <Line X1="2" Y1="14" X2="14" Y2="2" Width="16" Height="16" Stroke="{StaticResource AfterGlowTextPrimaryBrush}" StrokeThickness="2" StrokeDashArray="2,1.5" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                        </ToggleButton>
                        <ToggleButton x:Name="ArrowBtn" ToolTipService.ToolTip="矢印" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="ToolBtn_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE742;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                        </ToggleButton>

                        <Rectangle Width="1" Height="18" Fill="{StaticResource FluentSurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <ToggleButton x:Name="FillBtn" ToolTipService.ToolTip="塗りつぶし（四角形・楕円のみ）" Height="34" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0" CornerRadius="8" Padding="10,0" Click="FillBtn_Click" IsEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB33;" FontSize="15" />
                                <TextBlock Text="塗りつぶし" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- Row 2: Delete Sub-Toolbar -->
                <Border x:Name="DeleteSubBar"
                        Background="{StaticResource FluentSurfaceContainerHighestBrush}"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="8,4"
                        Translation="0,0,16"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton x:Name="EraseModeBtn" ToolTipService.ToolTip="描画物をクリックして削除" Height="34" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0" CornerRadius="8" Padding="10,0" IsChecked="True" Click="EraseModeBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE75C;" FontSize="15" />
                                <TextBlock Text="クリックして削除" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle Width="1" Height="18" Fill="{StaticResource FluentSurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <Button x:Name="ClearAllButton" ToolTipService.ToolTip="編集をすべて消去" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="10,0" Click="ClearButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="15" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                                <TextBlock Text="すべて消去" FontSize="12" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </views:CursorGrid>
    </Grid>
</Window>
