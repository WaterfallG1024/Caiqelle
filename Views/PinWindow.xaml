<Window
    x:Class="Caiqelle.Views.PinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pinned Image">

    <Grid x:Name="RootGrid" PointerEntered="RootGrid_PointerEntered" PointerExited="RootGrid_PointerExited" PointerPressed="RootGrid_PointerPressed" Background="Transparent">
        <!-- Pinned Image -->
        <Image x:Name="PinnedImage" Stretch="Uniform" />

        <!-- Overlay UI (Appears on Hover, M3 Expressive Panel) -->
        <Border x:Name="OverlayPanel" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Center" 
                Margin="0,12,0,0"
                Background="{StaticResource M3SurfaceContainerHighestBrush}" 
                BorderThickness="0" 
                CornerRadius="12" 
                Padding="6,4"
                Opacity="0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="CopyBtn" ToolTipService.ToolTip="コピー(またはCtrl + C)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="CopyBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                </Button>
                
                <Button x:Name="SaveBtn" ToolTipService.ToolTip="保存(またはCtrl + S)" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="SaveBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE792;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                </Button>

                <Rectangle Width="1" Height="18" Fill="{StaticResource M3SurfaceContainerLowBrush}" Margin="4,0" VerticalAlignment="Center" />

                <Button x:Name="CloseBtn" ToolTipService.ToolTip="ピン留め解除" Width="34" Height="34" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Click="CloseBtn_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource AfterGlowTextPrimaryBrush}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
