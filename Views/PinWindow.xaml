<Window
    x:Class="Caiqelle.Views.PinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pinned Image">

    <Grid x:Name="RootGrid" PointerEntered="RootGrid_PointerEntered" PointerExited="RootGrid_PointerExited" PointerPressed="RootGrid_PointerPressed" Background="Transparent" IsTabStop="True">
        <!-- Pinned Image -->
        <Image x:Name="PinnedImage" Stretch="Uniform" />
    </Grid>
</Window>
